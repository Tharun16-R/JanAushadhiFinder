<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Store Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/professional_card_background"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvStoreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Jan Aushadhi Stores"
            android:textColor="@color/primary_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStoreSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Find affordable medicines near your location"
            android:textColor="@color/text_secondary" />

        <!-- Statistics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvOpenStoresCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/professional_card_background"
                android:padding="12dp"
                android:text="0 stores open now"
                android:textColor="@color/success_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvNearbyStoresCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/professional_card_background"
                android:padding="12dp"
                android:text="0 stores within 5km"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- Filter Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnShowAllStores"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="All Stores"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_blue" />

            <Button
                android:id="@+id/btnShowOpenStores"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="Open Now"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/success_green" />

            <Button
                android:id="@+id/btnShowNearbyStores"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Nearby"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_purple" />
        </LinearLayout>
    </LinearLayout>

    <!-- Store List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp" />

</LinearLayout>