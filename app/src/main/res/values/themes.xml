<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main app theme with medical blue &amp; green colors -->
    <style name="Theme.JanaushadhiFinder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary blue from logo -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary/Accent green -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Tertiary -->
        <item name="colorTertiary">@color/primary_blue_light</item>
        <item name="colorOnTertiary">@color/white</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorBackgroundFloating">@color/light_blue_bg</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.JanaushadhiFinder.Splash" parent="Theme.SplashScreen">
        <!-- CRITICAL POINT TO YOUR LOGO -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_splash_icon</item>

        <!-- Background of the *entire screen* (should be white) -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>

        <!-- What theme to load after 3 seconds -->
        <item name="postSplashScreenTheme">@style/Theme.JanaushadhiFinder</item>
    </style>
</resources>