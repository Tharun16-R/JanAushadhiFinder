<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🔥 REQUIRED for Firebase / API calls -->
    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- Permissions for reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Permissions for calling stores -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_splash_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_splash_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.JanaushadhiFinder"
        tools:targetApi="31">

        <!-- Splash Screen (Hidden) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="false" />

        <!-- Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Login Screen (Launcher) -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signup Screen -->
        <activity
            android:name=".ui.SignupActivity"
            android:exported="false" />

        <!-- Reminder Receiver -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>